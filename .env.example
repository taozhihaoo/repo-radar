# Copy this file to .env and fill in values if needed. .env is gitignored.
# Format: KEY=VALUE, one per line; lines starting with # are comments.
# Real environment variables take precedence over .env values,
# and CLI flags take precedence over both (CLI > env > .env > default).

# GitHub personal access token (optional).
# Unauthenticated access allows 60 requests/hour; a token raises this to 5,000/hour.
# Never commit a real token.
# GITHUB_TOKEN=ghp_replace_with_your_own_token

# Optional tuning overrides.
# REPO_RADAR_TIMEOUT=10.0
# REPO_RADAR_MAX_RETRIES=3
# REPO_RADAR_WORKERS=4
